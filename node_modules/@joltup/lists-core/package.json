{
  "name": "@joltup/lists-core",
  "version": "3.2.0",
  "description": "Lists core business logic",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "rm -rf node_modules",
    "dist-package": "./scripts/distPackage.sh",
    "dist": "rm -rf dist/ && babel src --copy-files --out-dir dist && npm run dist-package",
    "format": "biome format --write",
    "lint": "biome lint",
    "publish-package": "npm run dist && npm run set-version && npm publish",
    "set-version": "npm version $(echo $CI_COMMIT_TAG | egrep -o '[0-9]+.[0-9]+.[0-9]+')",
    "test": "NODE_ENV=test TZ=UTC jest",
    "viewCoverage": "open ./coverage/lcov-report/index.html"
  },
  "keywords": [
    "lists",
    "core",
    "jolt",
    "module"
  ],
  "contributors": [],
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "immutable": "4.3.4",
    "lodash": "4.17.23",
    "moment-timezone": "0.5.45",
    "moment": "2.29.4",
    "numeral": "2.0.6",
    "qs": "6.14.1",
    "uuid": "9.0.1"
  },
  "jest": {
    "clearMocks": true,
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/index.js",
      "!src/utils/auth.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    },
    "moduleNameMapper": {
      "\\.(png|jpg|gif|ttf|eot|svg|css)$": "<rootDir>/fileMock.js"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/testSetup.js"
    ],
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "url": "http://localhost"
    },
    "testMatch": [
      "**/__tests__/*.test.js"
    ],
    "transform": {
      "\\.[jt]sx?$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(@joltup|lodash-es|babel-jest|dnd-core|react-dnd|uuid))"
    ]
  }
}
