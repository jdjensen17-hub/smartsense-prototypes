{
  "name": "@joltup/lists-hooks",
  "version": "3.1.1",
  "description": "Hooks for all!",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf node_modules",
    "dist": "rm -rf dist/ && babel src --out-dir dist --extensions .ts,.js,.tsx,.jsx --ignore \"src/index.d.ts\" && cp ./src/index.d.ts dist/index.d.ts && npm run dist-package",
    "dist-package": "./scripts/distPackage.js",
    "format": "prettier --write './**/*.{js,json,md,yml}' --ignore-path ../.prettierignore",
    "lint": "eslint src",
    "publish-package": "npm run dist && npm run set-version && npm publish",
    "set-version": "npm version $(echo $CI_COMMIT_TAG | egrep -o '[0-9]+.[0-9]+.[0-9]+')",
    "test": "NODE_ENV=test TZ=UTC jest",
    "viewCoverage": "open ./coverage/lcov-report/index.html"
  },
  "keywords": [
    "hooks",
    "jolt",
    "module"
  ],
  "contributors": [],
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "react": "18.3.1"
  },
  "workspaceDependencies": {},
  "jest": {
    "clearMocks": true,
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/index.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    },
    "setupFiles": [
      "<rootDir>/testSetup.js"
    ],
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "url": "http://localhost"
    },
    "testMatch": [
      "**/src/**/__tests__/*.test.js",
      "**/src/**/__tests__/*.test.ts"
    ],
    "transform": {
      "^.+\\.(js|jsx)?$": "babel-jest",
      "\\.tsx?$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(@joltup|lodash-es|babel-jest|dnd-core|react-dnd|uuid))"
    ]
  }
}