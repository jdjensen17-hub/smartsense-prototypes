{
  "name": "@joltup/shared-dev-utils",
  "version": "5.5.23",
  "dependencies": {
    "@apollo/client": "3.11.8",
    "@joltup/lists-core": "*",
    "@joltup/lists-web-data-components": "*",
    "@joltup/translations": "1.2.1",
    "cross-fetch": "3.1.5",
    "graphql": "16.13.2",
    "lodash": "4.17.23",
    "react-intl": "6.6.8"
  },
  "jest": {
    "clearMocks": true,
    "setupFilesAfterEnv": [
      "<rootDir>/testSetup.ts"
    ],
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "url": "http://localhost"
    },
    "testMatch": [
      "**/__tests__/*.test.js",
      "**/__tests__/*.test.ts",
      "**/__tests__/*.test.tsx"
    ],
    "transform": {
      "\\.jsx?$": "babel-jest",
      "\\.tsx?$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(@joltup|lodash-es|babel-jest|dnd-core|react-dnd|uuid|query-string|decode-uri-component|split-on-first|filter-obj))"
    ]
  },
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": "./index.js",
    "./utils": "./utils/index.js",
    "./utils/*": "./utils/*.js",
    "./types": "./types/index.js",
    "./types/*": "./types/*.js",
    "./wrappers": "./wrappers/index.js",
    "./wrappers/*": "./wrappers/*.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "types",
    "utils",
    "wrappers",
    "declarations"
  ]
}