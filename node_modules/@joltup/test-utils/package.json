{
  "name": "@joltup/test-utils",
  "version": "2.0.2",
  "description": "Angular test-utils component",
  "repository": "https://github.com/joltup/jolt-modules/tree/master/packages/test-utils",
  "main": "src/index.js",
  "files": [
    "src"
  ],
  "scripts": {
    "build": "../../node_modules/.bin/fe-build build",
    "clean": "../../node_modules/.bin/fe-build clean",
    "lint": "../../node_modules/.bin/fe-build lint",
    "test": "NODE_ENV=test ../../node_modules/.bin/fe-build test",
    "test-watch": "NODE_ENV=test ../../node_modules/.bin/fe-build test --watch",
    "start": "../../node_modules/.bin/fe-build start",
    "validate": "../../node_modules/.bin/fe-build validate",
    "watch": "../../node_modules/.bin/fe-build watch",
    "deploy": "../../node_modules/.bin/s3-cli sync -P ./dist s3://jolt-cdn/apps/$(basename `pwd`)",
    "set-version": "npm version $(echo $CI_COMMIT_TAG | egrep -o '[0-9]+.[0-9]+.[0-9]+')",
    "publish": "npm run set-version && npm publish"
  },
  "keywords": [
    "jolt",
    "module"
  ],
  "contributors": [],
  "license": "SEE LICENSE IN LICENSE"
}
