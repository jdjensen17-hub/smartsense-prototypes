{
  "name": "@joltup/lists-web-data-components",
  "version": "1.0.4",
  "description": "React web components with API connections",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build-storybook": "build-storybook -c .storybook",
    "build": "npm run build-storybook",
    "clean": "rm -rf node_modules",
    "deploy": "../uploadBranch.sh 'lists-web-data-components/' './storybook-static'",
    "dist-package": "./scripts/distPackage.sh",
    "dist": "rm -rf dist/ && babel src --out-dir dist && npm run dist-package",
    "format": "prettier --write './**/*.{js,json,md,yml}' --ignore-path ../.prettierignore",
    "lint": "eslint src",
    "publish": "npm run dist && npm run set-version && npm publish",
    "set-version": "npm version $(echo $CI_COMMIT_TAG | egrep -o '[0-9]+.[0-9]+.[0-9]+')",
    "start": "npm run storybook",
    "storybook": "start-storybook -p 3002",
    "relay": "echo \"lists-web-data-components does not have relay\"",
    "generateSchema": "echo \"lists-web-data-components does not have generateSchema\"",
    "test": "NODE_ENV=test TZ=UTC jest",
    "uploadBranch": "../uploadBranch.sh \"__DEV__/lists-web-data-components/$CI_COMMIT_REF_NAME\" './storybook-static'",
    "viewCoverage": "open ./coverage/lcov-report/index.html"
  },
  "keywords": [
    "components",
    "jolt",
    "module",
    "react"
  ],
  "contributors": [],
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@emotion/react": "11.9.3",
    "@emotion/styled": "11.9.3",
    "@apollo/client": "3.7.10",
    "apollo-link-http": "1.5.17",
    "cross-fetch": "3.1.5",
    "apollo-link": "1.2.14",
    "axios": "0.21.1",
    "graphql-relay": "0.10.0",
    "moment-timezone": "0.5.34",
    "moment": "2.29.3",
    "react-onclickoutside": "6.10.0",
    "react": "18.2.0"
  },
  "devDependencies": {
    "@babel/cli": "7.18.6",
    "@babel/core": "7.18.10",
    "@babel/eslint-parser": "7.18.9",
    "@babel/node": "7.18.6",
    "@babel/plugin-proposal-class-properties": "7.18.6",
    "@babel/plugin-proposal-object-rest-spread": "7.18.6",
    "@babel/plugin-proposal-optional-chaining": "7.18.6",
    "@babel/polyfill": "7.12.1",
    "@babel/preset-env": "7.18.6",
    "@babel/preset-react": "7.18.6",
    "@emotion/babel-plugin": "11.9.2",
    "@emotion/eslint-plugin": "11.7.0",
    "@emotion/jest": "11.10.0",
    "@joltup/web-babel": "0.0.4",
    "@joltup/web-eslint": "2.1.0",
    "@joltup/webpack-tools": "0.0.16",
    "@storybook/cli": "6.5.9",
    "@storybook/react": "6.5.9",
    "@testing-library/react-hooks": "5.1.1",
    "babel-jest": "29.0.1",
    "babel-plugin-react-docgen": "4.2.1",
    "babel-plugin-transform-runtime": "6.23.0",
    "eslint-import-resolver-webpack": "0.13.2",
    "eslint-plugin-import": "2.27.5",
    "eslint-plugin-jest": "27.2.1",
    "eslint-plugin-react": "7.32.2",
    "eslint": "8.40.0",
    "jest-emotion": "11.0.0",
    "jest-environment-jsdom": "29.0.1",
    "jest-runtime": "29.0.1",
    "jest-styled-components": "7.1.0",
    "jest": "29.0.1",
    "jsdom": "20.0.0",
    "prettier": "2.6.2",
    "react-test-renderer": "17.0.2",
    "regenerator-runtime": "0.13.7",
    "uglifyjs-webpack-plugin": "1.2.4",
    "webpack-cli": "2.0.12",
    "webpack-dev-server": "3.11.2",
    "webpack-merge": "4.2.2",
    "webpack-serve": "0.2.0",
    "webpack": "4.41.2",
    "yarn": "1.22.10"
  },
  "workspaceDependencies": {
    "@joltup/lists-core": "*",
    "@joltup/lists-hooks": "*",
    "@joltup/lists-web-components": "*"
  },
  "jest": {
    "clearMocks": true,
    "collectCoverage": true,
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.dataLayer.js",
      "!src/**/examples/*.*",
      "!src/**/index.js",
      "!src/filters/useFilterData.js",
      "!src/index.js",
      "!src/utilities/clam.js",
      "!src/utilities/JobSchedulerNetworkRequest.js",
      "!src/utilities/NetworkRequest.js",
      "!src/utilities/queries.js",
      "!src/utilities/time.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    },
    "moduleNameMapper": {
      "\\.(png|jpg|gif|ttf|eot|svg|css)$": "<rootDir>/fileMock.js"
    },
    "setupFiles": [
      "<rootDir>/testSetup.js"
    ],
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "url": "http://localhost"
    },
    "testMatch": [
      "**/__tests__/*.test.js"
    ],
    "transform": {
      "^.+\\.(js|jsx)?$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(@joltup|lodash-es|babel-jest|dnd-core|react-dnd|uuid))"
    ]
  }
}
