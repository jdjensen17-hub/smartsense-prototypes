{
  "name": "@joltup/lists-web-components",
  "version": "5.5.23",
  "description": "React web components using material design",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build-storybook",
    "build-storybook": "storybook build",
    "clean": "rm -rf node_modules",
    "deploy": "../scripts/deploy/uploadBranch.sh 'lists-web-docs/' './storybook-static'",
    "dist": "rm -rf dist/ && babel src --out-dir dist --extensions .ts,.js,.tsx,.jsx --ignore \"src/index.d.ts\" && cp ./src/index.d.ts dist/index.d.ts && npm run dist-package",
    "dist-package": "./scripts/distPackage.js",
    "format": "biome format --write",
    "generateComponent": "babel-node ../generateComponent.js",
    "lint": "biome lint",
    "publish-package": "npm run dist && npm publish",
    "start": "npm run storybook",
    "storybook": "storybook dev -p 6006",
    "test": "NODE_ENV=test TZ=UTC jest",
    "uploadBranch": "../scripts/deploy/uploadBranch.sh \"__DEV__/lists-web-docs/$CI_COMMIT_REF_NAME\" './storybook-static'",
    "viewCoverage": "open ./coverage/lcov-report/index.html"
  },
  "keywords": [
    "material",
    "react",
    "jolt",
    "module"
  ],
  "contributors": [],
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@apollo/client": "3.9.11",
    "@emotion/babel-preset-css-prop": "11.12.0",
    "@emoji-mart/data": "1.2.1",
    "@emoji-mart/react": "1.1.1",
    "emoji-mart": "5.6.0",
    "@joltup/colors": "1.3.0",
    "@joltup/shared-dev-utils": "*",
    "@joltup/test-utils": "2.0.2",
    "@joltup/text": "2.1.0",
    "@joltup/translations": "1.2.1",
    "@mui/material": "5.15.15",
    "@mui/x-date-pickers": "7.13.0",
    "ag-grid-community": "33.1.1",
    "ag-grid-enterprise": "33.1.1",
    "ag-grid-react": "33.1.1",
    "classnames": "2.3.1",
    "cron-parser": "4.9.0",
    "cross-fetch": "3.1.5",
    "moment": "2.30.1",
    "moment-timezone": "0.5.45",
    "prop-types": "15.7.2",
    "qrcode": "1.4.4",
    "react": "18.3.1",
    "react-barcode": "1.4.0",
    "react-beautiful-dnd": "13.1.1",
    "react-color": "2.19.3",
    "react-complex-tree": "2.1.1",
    "react-dom": "18.3.1",
    "react-immutable-proptypes": "2.2.0",
    "react-infinite-scroller": "1.2.4",
    "react-intl": "6.4.1",
    "react-moment-proptypes": "1.8.1",
    "react-onclickoutside": "6.10.0",
    "react-qr-code": "^2.0.15",
    "react-router-dom": "6.30.3",
    "recharts": "2.9.2",
    "runes": "0.4.3"
  },
  "workspaceDependencies": {
    "@joltup/lists-core": "*",
    "@joltup/lists-hooks": "*"
  },
  "jest": {
    "clearMocks": true,
    "collectCoverage": false,
    "collectCoverageFrom": [
      "src/**/*.js",
      "src/**/*.ts",
      "src/**/*.tsx",
      "!src/**/*.dataLayer.js",
      "!src/**/*.stories.js",
      "!src/**/examples/*.*",
      "!src/**/index.js",
      "!src/**/index.ts",
      "!src/**/stories/*.*",
      "!src/components/index.js",
      "!src/index.d.ts",
      "!src/index.js",
      "!src/utilities/breakpoints.js",
      "!src/components/dataGrid/**/*.ts",
      "!src/components/dataGrid/**/*.tsx"
    ],
    "moduleNameMapper": {
      "\\.(png|jpg|gif|ttf|eot|svg|css)$": "<rootDir>/fileMock.js"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/testSetup.ts"
    ],
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "url": "http://localhost"
    },
    "testMatch": [
      "**/src/**/__tests__/*.test.js",
      "**/src/**/__tests__/*.test.jsx",
      "**/src/**/__tests__/*.test.ts",
      "**/src/**/__tests__/*.test.tsx"
    ],
    "transform": {
      "^.+\\.(js|jsx)?$": "babel-jest",
      "\\.tsx?$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(@joltup|lodash-es|babel-jest|dnd-core|react-dnd|uuid))"
    ]
  }
}