{
  "name": "@joltup/translations",
  "version": "1.2.1",
  "description": "Jolt translations",
  "repository": "https://gitlab.joltup.com/jolt/core/tree/master/packages/translations",
  "main": "index.js",
  "types": "index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "echo \"No build required for translations\"",
    "deploy": "echo \"Translations do not need to be deployed\"",
    "jolt-publish": "npm run set-version && npm publish",
    "lint": "eslint .",
    "set-version": "npm version $(echo $CI_COMMIT_TAG | egrep -o '[0-9]+.[0-9]+.[0-9]+')",
    "test-watch": "NODE_ENV=test jest -- --watch",
    "test": "NODE_ENV=test jest",
    "validate": "npm run lint && npm run test"
  },
  "devDependencies": {
    "@babel/core": "7.0.0",
    "@babel/plugin-proposal-class-properties": "7.8.3",
    "@babel/plugin-proposal-object-rest-spread": "7.8.3",
    "@babel/preset-env": "7.9.0",
    "@babel/preset-react": "7.8.3",
    "@joltup/web-eslint": "0.0.4",
    "babel-jest": "25.1.0",
    "jest": "25.1.0"
  }
}
